{
  "name": "harmonica-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx vite build",
    "verify:colors": "bun run scripts/verify-colors.ts",
    "preview": "bunx vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:browser": "playwright test --workers=6",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "capture:release": "bun run scripts/capture-release.ts",
    "benchmark:pitch": "bun run scripts/pitch-benchmark.ts"
    ,"score:ingest": "bun run scripts/score-ingest.ts"
    ,"score:benchmark": "bun run scripts/score-benchmark.ts"
    ,"score:adapters": "bun run scripts/score-adapters.ts"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "@vitejs/plugin-react": "5.0.2",
    "abcjs": "6.5.2",
    "jszip": "3.10.1",
    "pitchy": "4.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
